# WhatsApp (Twilio)
# Temporarily disabled: Twilio integration is not in use.
# Do not remove yet, pending migration to WhatsApp Cloud API.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ENABLED=false
NOTIFICATIONS_WHATSAPP_ENABLED=false
WHATSAPP_USE_CONTENT_TEMPLATES=false
# Optional Content Template SIDs (required for business-initiated WhatsApp in production)
TWILIO_CONTENT_SID_CREATED_PATIENT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_CREATED_DOCTOR=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_CANCELLED_PATIENT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_CANCELLED_DOCTOR=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_REMINDER_24H_PATIENT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_REMINDER_24H_DOCTOR=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_REMINDER_2H_PATIENT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_REMINDER_2H_DOCTOR=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional delivery check to detect async Twilio failures (sandbox/session/trial)
WHATSAPP_DELIVERY_CHECK_TIMEOUT_MS=3000
WHATSAPP_DELIVERY_CHECK_INTERVAL_MS=750

# Doctor destination phone (fallback if no doctor entity/phone is available)
